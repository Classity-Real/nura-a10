# Kernel for Samsung Galaxy A10 (samsung-a10), based on the
# exynos7885-mainline fork at github.com/Classity-Real/linux-a10-mainline
maintainer="Classity-Real <classity-real@users.noreply.github.com>"
pkgname=linux-samsung-a10
pkgver=6.15_rc1
pkgrel=0
pkgdesc="Mainline-based kernel for Samsung Galaxy A10 (Exynos 7884B/7885)"
arch="aarch64"
_carch="arm64"
_flavor="samsung-a10"
url="https://github.com/Classity-Real/linux-a10-mainline"
license="GPL-2.0-only"
options="!strip !check !tracedeps pmb:cross-native"
makedepends="
bc
bison
clang
elfutils-dev
flex
linux-headers
lld
llvm
openssl-dev
pahole
perl
postmarketos-installkernel
python3
zstd
"

_owner="Classity-Real"
_repo="linux-a10-mainline"
_commit="899fa5f15372edea7669ed2399f0c300e0fab1ac"
_config="config-postmarketos-$_flavor.aarch64"

source="
$_repo-$_commit.tar.gz::https://github.com/$_owner/$_repo/archive/$_commit.tar.gz
$_config
"
builddir="$srcdir/$_repo-$_commit"

prepare() {
default_prepare
cp "$srcdir/$_config" .config
make ARCH="$_carch" LLVM=1 olddefconfig
}

build() {
unset LDFLAGS
make ARCH="$_carch" LLVM=1 HOSTLDFLAGS="-fuse-ld=lld" \
KBUILD_BUILD_VERSION="$((pkgrel + 1))-postmarketOS"
}

package() {
mkdir -p "$pkgdir"/boot

make install dtbs_install modules_install \
ARCH="$_carch" \
LLVM=1 \
INSTALL_PATH="$pkgdir"/boot \
INSTALL_MOD_PATH="$pkgdir"/usr \
INSTALL_MOD_STRIP=1 \
INSTALL_DTBS_PATH="$pkgdir"/boot/dtbs
rm -f "$pkgdir"/usr/lib/modules/*/build "$pkgdir"/usr/lib/modules/*/source

install -D "$builddir"/include/config/kernel.release \
"$pkgdir"/usr/share/kernel/"$_flavor"/kernel.release

install -Dm644 "$builddir"/arch/"$_carch"/boot/Image \
"$pkgdir"/boot/vmlinuz
}

sha512sums="
d8a19445b3af6f677448f41e99d15281d2c38b7aec986f81ed9f0e51ac888f48c98eceee3c1d4f966cbbd2b74875a01692162d3be4d6c0f238a094cbf0dc4e3f  linux-a10-mainline-899fa5f15372edea7669ed2399f0c300e0fab1ac.tar.gz
fd5c0a6a4132459a111842e1af487118eedce667a79a1648783146762ea2d1422dccfb07d181d38f573a5177fce7e8581851294b02c9e8c9595a7f1fbc13dde3  config-postmarketos-samsung-a10.aarch64
"
